{
  "name": "@controlstack/oac",
  "version": "1.1.0",
  "description": "AI agent framework for plan-first development workflows with approval-based execution. Multi-language support for TypeScript, Python, Go, Rust and more.",
  "packageManager": "pnpm@10.33.4",
  "bin": {
    "oac": "./bin/oac.js"
  },
  "files": [
    ".opencode/agent/",
    ".opencode/command/",
    ".opencode/context/",
    ".opencode/profiles/",
    ".opencode/prompts/",
    ".opencode/scripts/",
    ".opencode/skills/",
    ".opencode/config.json",
    ".opencode/opencode.json",
    "v1-opencode/",
    "!.opencode/node_modules/",
    "!**/node_modules/",
    "scripts/",
    "bin/",
    "registry.json",
    "registry.v1.json",
    "install.sh",
    "env.example",
    "VERSION",
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "CONTEXT_SYSTEM_GUIDE.md",
    "packages/cli/dist/"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test:local": "pnpm --dir evals/v2 exec tsx src/cli.ts",
    "test": "pnpm run test:all",
    "test:all": "pnpm --dir evals/framework run eval:sdk",
    "test:core": "pnpm run test:openagent:core",
    "test:openagent": "pnpm --dir evals/framework run eval:sdk -- --agent=openagent",
    "test:openagent:core": "pnpm --dir evals/framework run eval:sdk:core -- --agent=openagent",
    "test:opencoder": "pnpm --dir evals/framework run eval:sdk -- --agent=opencoder",
    "test:openagent:grok": "pnpm run test:openagent -- --model=opencode/grok-code-fast",
    "test:openagent:claude": "pnpm run test:openagent -- --model=anthropic/claude-3-5-sonnet-20241022",
    "test:openagent:gpt4": "pnpm run test:openagent -- --model=openai/gpt-4-turbo",
    "test:opencoder:grok": "pnpm run test:opencoder -- --model=opencode/grok-code-fast",
    "test:opencoder:claude": "pnpm run test:opencoder -- --model=anthropic/claude-3-5-sonnet-20241022",
    "test:opencoder:gpt4": "pnpm run test:opencoder -- --model=openai/gpt-4-turbo",
    "test:all:grok": "pnpm run test:all -- --model=opencode/grok-code-fast",
    "test:all:claude": "pnpm run test:all -- --model=anthropic/claude-3-5-sonnet-20241022",
    "test:all:gpt4": "pnpm run test:all -- --model=openai/gpt-4-turbo",
    "test:pattern": "pnpm --dir evals/framework run eval:sdk -- --pattern",
    "test:debug": "pnpm --dir evals/framework run eval:sdk -- --debug",
    "test:openagent:developer": "pnpm run test:openagent -- --pattern='developer/*.yaml'",
    "test:openagent:context": "pnpm run test:openagent -- --pattern='context-loading/*.yaml'",
    "test:openagent:business": "pnpm run test:openagent -- --pattern='business/*.yaml'",
    "test:opencoder:developer": "pnpm run test:opencoder -- --pattern='developer/*.yaml'",
    "test:opencoder:bash": "pnpm run test:opencoder -- --pattern='developer/bash-*.yaml'",
    "test:ci": "pnpm run test:ci:openagent && pnpm run test:ci:opencoder",
    "test:ci:openagent": "pnpm run test:openagent -- --pattern='smoke-test.yaml' --no-evaluators",
    "test:ci:opencoder": "pnpm run test:opencoder -- --pattern='developer/simple-bash-test.yaml' --no-evaluators",
    "dashboard": "cd evals/results && ./serve.sh",
    "dashboard:open": "pnpm run dashboard && open http://localhost:8000",
    "results:openagent": "echo 'OpenAgent results:' && ls -lh evals/results/history/*openagent*.json 2>/dev/null | tail -5 || echo 'No results yet'",
    "results:opencoder": "echo 'OpenCoder results:' && ls -lh evals/results/history/*opencoder*.json 2>/dev/null | tail -5 || echo 'No results yet'",
    "results:latest": "cat evals/results/latest.json 2>/dev/null | jq '.agent, .passed, .failed' || echo 'No results yet'",
    "version": "node -p \"require('./package.json').version\"",
    "version:bump": "./scripts/versioning/bump-version.sh",
    "version:bump:patch": "npm version patch --no-git-tag-version && node -p \"require('./package.json').version\" > VERSION",
    "version:bump:minor": "npm version minor --no-git-tag-version && node -p \"require('./package.json').version\" > VERSION",
    "version:bump:major": "npm version major --no-git-tag-version && node -p \"require('./package.json').version\" > VERSION",
    "version:bump:alpha": "npm version prerelease --preid=alpha --no-git-tag-version && node -p \"require('./package.json').version\" > VERSION",
    "version:bump:beta": "npm version prerelease --preid=beta --no-git-tag-version && node -p \"require('./package.json').version\" > VERSION",
    "version:bump:rc": "npm version prerelease --preid=rc --no-git-tag-version && node -p \"require('./package.json').version\" > VERSION",
    "dev:setup": "pnpm install",
    "dev:build": "pnpm --dir evals/framework run build",
    "dev:test": "pnpm --dir evals/framework test",
    "dev:clean": "rm -rf evals/framework/dist node_modules evals/framework/node_modules && pnpm install",
    "validate:registry": "bun run scripts/registry/validate-registry.ts",
    "validate:context-links": "bun run scripts/validation/validate-markdown-links.ts",
    "validate:registry:verbose": "bun run scripts/registry/validate-registry.ts -v",
    "validate:registry:fix": "bun run scripts/registry/validate-registry.ts -f"
  },
  "keywords": [
    "opencode",
    "openagents",
    "ai-agents",
    "code-generation",
    "development-workflow",
    "plan-first",
    "context-aware",
    "typescript",
    "python",
    "go",
    "rust",
    "cli",
    "automation"
  ],
  "author": "Darren Hinde",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/darrenhinde/OpenAgentsControl.git"
  },
  "bugs": {
    "url": "https://github.com/darrenhinde/OpenAgentsControl/issues"
  },
  "homepage": "https://github.com/darrenhinde/OpenAgentsControl#readme",
  "pnpm": {
    "onlyBuiltDependencies": []
  },
  "devDependencies": {
    "glob": "^13.0.0"
  }
}
